<Window x:Class="videojatek.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Játékgyűjtemény" Height="650" Width="1050"
        MinHeight="550" MinWidth="850"
        WindowStartupLocation="CenterScreen"
        Background="#12121A">

    <Window.Resources>
        <!-- MENU GOMBOK ALAPVETO STILUSA -->
        <Style x:Key="MenuButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Black"/>
            <Setter Property="Foreground" Value="#D5A7F4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="GombHatter" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="GombHatter" Property="Background" Value="#302344"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- SZÖVEGDOBOZ STILUSA -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#1D1B27"/>
            <Setter Property="Foreground" Value="#D5A7F4"/>
            <Setter Property="BorderBrush" Value="#40364F"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="9,5"/>
        </Style>

        <!--COMBOBOX STILUSA-->
        <Style TargetType="{x:Type ComboBox}">
            <Setter Property="Background" Value="Black"/>
            <Setter Property="Foreground" Value="#D5A7F4"/>
            <Setter Property="BorderBrush" Value="#40364F"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBox}">
                        <Grid>
                            <!-- A bezárt ComboBox háttere -->
                            <Border
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="5">

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="25"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- A kiválasztott elem -->
                                    <ContentPresenter
                                Grid.Column="0"
                                Margin="8,2,2,2"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Left"
                                Content="{TemplateBinding SelectionBoxItem}"
                                TextElement.Foreground="{TemplateBinding Foreground}"/>

                                    <!-- Lenyíló nyíl -->
                                    <ToggleButton
                                Grid.Column="1"
                                Background="Transparent"
                                BorderThickness="0"
                                Focusable="False"
                                IsChecked="{Binding IsDropDownOpen,
                                    Mode=TwoWay,
                                    RelativeSource={RelativeSource TemplatedParent}}">
                                        <Path
                                    Data="M 0 0 L 4 4 L 8 0 Z"
                                    Fill="#F7F3FF"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"/>
                                    </ToggleButton>
                                </Grid>
                            </Border>

                            <!-- A lenyíló lista -->
                            <Popup
                        IsOpen="{TemplateBinding IsDropDownOpen}"
                        Placement="Bottom"
                        AllowsTransparency="True"
                        PopupAnimation="Slide">
                                <Border
                            Background="#1D1B27"
                            BorderBrush="#40364F"
                            BorderThickness="1"
                            CornerRadius="5"
                            MinWidth="{Binding ActualWidth,
                                RelativeSource={RelativeSource AncestorType=ComboBox}}">
                                    <ScrollViewer MaxHeight="200">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="Black"/>
            <Setter Property="Foreground" Value="#D5A7F4"/>
            <Setter Property="Padding" Value="8,5"/>

            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="#40305F"/>
                    <Setter Property="Foreground" Value="#D5A7F4"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- BAL OLDALI MENÜ-->
        <Border Grid.Column="0" Background="#191722" BorderBrush="#302A3B" BorderThickness="0,0,1,0">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top" Margin="18,22,18,18">
                    <TextBlock Text="MENÜ" Foreground="#D5A7F4" FontSize="20" FontWeight="SemiBold" Margin="2,0,0,8"/>
                    <Border Background="MediumPurple" Height="2" Margin="0,0,0,12"/> 
                    <Button Style="{StaticResource MenuButtonStyle}" Content="Játékgyűjtemény" Click="Jatekgyujtemeny" />
                    <Button Style="{StaticResource MenuButtonStyle}" Content="Játék hozzáadása" Click="Jatekkezelo"/>
                    <Button Style="{StaticResource MenuButtonStyle}" Content="Játékosok és értékelések" Click="JatekosokEsErtekelesek"/>
                    <Button Style="{StaticResource MenuButtonStyle}" Content="Adatok frissítése" Click="Frissites"/>
                    <Button Style="{StaticResource MenuButtonStyle}" Content="Kilépés" Margin="0,12,0,0" Click="Kilepes"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- JOBB OLDALI TARTALOM -->
        <Grid Grid.Column="1" Margin="24,22,24,20">
            <Grid x:Name="HomeContentGrid">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,18">
                    <TextBlock Text="A játékaid" Foreground="#D5A7F4" FontSize="25" FontWeight="SemiBold"/>
                    <TextBlock Text="Itt tekintheted át és keresheted meg a gyűjteményed játékait." Foreground="#D5A7F4" FontSize="12" Margin="0,5,0,0"/>
                </StackPanel>

                <Border Grid.Row="1" Background="#191722" BorderBrush="#302A3B" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="1.2*"/>
                            <ColumnDefinition Width="1.2*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Keresősáv -->
                        <TextBox x:Name="Keresosav" Grid.Column="0" Height="34" VerticalContentAlignment="Center" Margin="0,0,10,0" ToolTip="Játék keresése" VerticalAlignment="Top" TextChanged="Keresosav_TextChanged"/>

                        <!-- Platform választó - Most már az adatbázisból jön! -->
                        <ComboBox x:Name="Platform_valaszto" Grid.Column="1" Height="34" Margin="0,0,10,0" 
                  ItemsSource="{Binding Platforms}" SelectedIndex="0" 
                  VerticalContentAlignment="Center" SelectionChanged="Platform_valaszto_SelectionChanged" VerticalAlignment="Top"/>

                        <!-- Kategória / Műfaj választó - Most már a Types táblából jön! -->
                        <ComboBox x:Name="Kategoria_valaszto" Grid.Column="2" Height="34" 
                  ItemsSource="{Binding Categories}" SelectedIndex="0" 
                  VerticalContentAlignment="Center" Background="Black" SelectionChanged="Kategoria_valaszto_SelectionChanged_1"/>
                    </Grid>
                </Border>

                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="JÁTÉKOK" Foreground="#D5A7F4" FontSize="10" FontWeight="SemiBold" Margin="2,0,0,8"/>
                        <ItemsControl ItemsSource="{Binding Games}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="330" MinHeight="145" Background="#191722" BorderBrush="#3C304D"
                                            BorderThickness="1" CornerRadius="9" Margin="0,0,12,12" Padding="10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="95"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Background="#292536" CornerRadius="6" Margin="0,0,10,0">
                                                <Image Source="{Binding CoverImage}" Stretch="UniformToFill"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="15" Foreground="#F5F0FF" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding Company}" FontSize="11" Foreground="#B7A9CB" Margin="0,5,0,0"/>
                                                <TextBlock Text="{Binding ReleaseDate}" FontSize="11" Foreground="#A99DBB" Margin="0,2,0,0"/>
                                                <TextBlock Text="{Binding VotesText}" FontSize="11" Foreground="#D5A7F4" FontWeight="SemiBold" Margin="0,9,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- A külön oldal a Játék hozzáadása gombbal nyílik meg -->
            <Frame x:Name="MainFrame" NavigationUIVisibility="Hidden" Visibility="Collapsed" Background="#12121A"/>
        </Grid>
    </Grid>
</Window>
