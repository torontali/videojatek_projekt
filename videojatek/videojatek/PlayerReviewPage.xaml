<Page x:Class="videojatek.PlayerReviewPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Játékosok és értékelések"
      Loaded="Page_Loaded">
    <Page.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#1D1B27"/>
            <Setter Property="Foreground" Value="#D5A7F4"/>
            <Setter Property="BorderBrush" Value="#40364F"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Margin" Value="0,4,0,8"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#1D1B27"/>
            <Setter Property="Foreground" Value="#D5A7F4"/>
            <Setter Property="Margin" Value="0,4,0,8"/>
            <Setter Property="Padding" Value="6,4"/>
        </Style>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background" Value="Black"/>
            <Setter Property="Foreground" Value="#D5A7F4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Margin" Value="0,4,8,8"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Page.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" Background="#12121A">
        <StackPanel Margin="24" MaxWidth="1100" HorizontalAlignment="Left">
            <TextBlock Text="Játékosok, értékelések és statisztikák" FontSize="25" FontWeight="SemiBold" Foreground="#D5A7F4" Margin="0,0,0,14"/>
            <TextBlock x:Name="StatisticsText" Text="Statisztikák betöltése..." Foreground="#F5F0FF" FontSize="14" Margin="0,0,0,16"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="#191722" BorderBrush="#302A3B" BorderThickness="1" CornerRadius="10" Padding="16">
                    <StackPanel>
                        <TextBlock Text="Játékoskezelés" FontSize="18" FontWeight="SemiBold" Foreground="#D5A7F4" Margin="0,0,0,8"/>
                        <TextBlock Text="Felhasználónév" Foreground="#D5A7F4"/>
                        <TextBox x:Name="UsernameBox"/>
                        <TextBlock Text="E-mail" Foreground="#D5A7F4"/>
                        <TextBox x:Name="EmailBox"/>
                        <TextBlock Text="Szint" Foreground="#D5A7F4"/>
                        <TextBox x:Name="LevelBox" Text="1"/>
                        <WrapPanel>
                            <Button Style="{StaticResource ActionButton}" Content="Játékos hozzáadása" Click="AddPlayer_Click"/>
                            <Button Style="{StaticResource ActionButton}" Content="Kijelölt törlése" Click="DeletePlayer_Click"/>
                        </WrapPanel>
                        <TextBlock Text="Játékosok" Foreground="#D5A7F4" Margin="0,8,0,4"/>
                        <ListBox x:Name="PlayersList" Height="180" DisplayMemberPath="Username" Background="#1D1B27" Foreground="#D5A7F4" SelectionChanged="PlayersList_SelectionChanged"/>
                        <TextBlock x:Name="PlayerGamesText" Text="Válassz ki egy játékost az értékelt játékaihoz." TextWrapping="Wrap" Foreground="#B7A9CB" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Background="#191722" BorderBrush="#302A3B" BorderThickness="1" CornerRadius="10" Padding="16">
                    <StackPanel>
                        <TextBlock Text="Értékelés hozzáadása" FontSize="18" FontWeight="SemiBold" Foreground="#D5A7F4" Margin="0,0,0,8"/>
                        <TextBlock Text="Játékos" Foreground="#D5A7F4"/>
                        <ComboBox x:Name="PlayerSelect" DisplayMemberPath="Username"/>
                        <TextBlock Text="Játék" Foreground="#D5A7F4"/>
                        <ComboBox x:Name="GameSelect" DisplayMemberPath="Name"/>
                        <TextBlock Text="Pontszám (1–5)" Foreground="#D5A7F4"/>
                        <ComboBox x:Name="PointsSelect" SelectedIndex="4">
                            <ComboBoxItem Content="1"/><ComboBoxItem Content="2"/><ComboBoxItem Content="3"/><ComboBoxItem Content="4"/><ComboBoxItem Content="5"/>
                        </ComboBox>
                        <TextBlock Text="Vélemény" Foreground="#D5A7F4"/>
                        <TextBox x:Name="CommentBox" Height="70" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                        <WrapPanel>
                            <Button Style="{StaticResource ActionButton}" Content="Értékelés mentése" Click="AddReview_Click"/>
                            <Button Style="{StaticResource ActionButton}" Content="Értékelés törlése" Click="DeleteReview_Click"/>
                        </WrapPanel>
                        <TextBlock Text="Értékelések" Foreground="#D5A7F4" Margin="0,8,0,4"/>
                        <ListBox x:Name="ReviewsList" Height="210" Background="#1D1B27" Foreground="#D5A7F4">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#40364F" BorderThickness="0,0,0,1" Padding="5">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Points, StringFormat='Pontszám: {0}/5'}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding GameId, StringFormat='Játék ID: {0}'}"/>
                                            <TextBlock Text="{Binding PlayerId, StringFormat='Játékos ID: {0}'}"/>
                                            <TextBlock Text="{Binding Comment}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
